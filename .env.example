# Copy to `.env` (which is git-ignored) and fill in. Never commit real credentials.
#
# IBM Quantum Platform (https://quantum.cloud.ibm.com): an IBM Cloud API key.
QP_IBM_TOKEN=
# Optional: the CRN of your Quantum service instance. Leave empty to auto-select.
QP_IBM_INSTANCE=
# Optional: default IBM backend, e.g. ibm_fez, ibm_marrakesh, ibm_torino (or leave empty for least busy).
QP_IBM_BACKEND=
# Optional: channel (default ibm_quantum_platform).
QP_IBM_CHANNEL=ibm_quantum_platform

# AWS Braket uses the standard AWS credential chain (AWS_PROFILE, AWS_ACCESS_KEY_ID, ...).
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=us-east-1

# Where the job store and settings live (default: ~/.qplay)
# QP_HOME=
